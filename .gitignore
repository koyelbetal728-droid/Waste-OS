__pycache__/
*.pyc
.venv/
node_modules/
.next/
*.log
.env

# Pretrained base weights (yolo11s.pt, yolo11m.pt, ...) are auto-downloaded by
# ultralytics into the cwd. Never commit them — the training scripts re-fetch
# as needed. This rule must stay ABOVE the negations below, because git applies
# the last matching pattern.
*.pt

data/raw/*
!data/raw/.gitkeep
models/artifacts/*
!models/artifacts/.gitkeep

# Trained detector checkpoints ARE committed so a collaborator can continue a
# run instead of retraining from COCO weights. Only last.pt (54MB — it carries
# the optimizer state and epoch counter that --resume-full needs) plus its
# SHA256. best.pt is byte-identical to last.pt at the end of a run, and the
# per-epoch images/plots/results stay ignored.
!models/artifacts/detect/
models/artifacts/detect/*
!models/artifacts/detect/*/
!models/artifacts/detect/*/weights/
models/artifacts/detect/*/weights/*
!models/artifacts/detect/*/weights/last.pt
!models/artifacts/detect/*/weights/last.pt.sha256